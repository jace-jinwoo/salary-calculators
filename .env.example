# 배포 도메인 (canonical, sitemap, Open Graph 기준). 끝에 슬래시 없이 입력
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# 문의 페이지에 표시할 이메일 (비워 두면 "설정 필요" 안내가 표시됩니다)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Google AdSense: 승인 전에는 반드시 false 로 유지 ---
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
